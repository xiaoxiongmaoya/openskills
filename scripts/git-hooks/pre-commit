#!/bin/sh
# 红线守卫：禁止把真实当事人信息（姓名/身份证/手机/银行卡/案号/地址）提交进仓库。
# 规则来源：用户 2026-11-19 定的铁律 —— skills 与项目任何文件、文档、模板都不得泄露。
# 需要临时跳过时用 git commit --no-verify，但那是违规操作，事后必须清理历史。
ROOT=$(git rev-parse --show-toplevel)
python "$ROOT/scripts/check_sensitive.py" --staged
if [ $? -ne 0 ]; then
  echo "" >&2
  echo "提交已拦截。先脱敏：姓名→张三/李四，身份证→110101199001010000，" >&2
  echo "手机→13800000000，银行卡→123456789012345678，案号→（2025）浙0000民初1号" >&2
  exit 1
fi
